{
  "name": "legends-rotaract",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:content": "node --loader ./scripts/utilities/ts-loader.mjs scripts/validation/check-content.mjs",
    "audit:event-photos": "node --loader ./scripts/utilities/ts-loader.mjs scripts/validation/audit-event-photos.mjs",
    "test:members-hub": "node --test tests/members-hub-security.test.mjs tests/members-hub-phase2.test.mjs tests/members-hub-phase3.test.mjs tests/three-portals-security.test.mjs tests/bod-provisioning-security.test.mjs",
    "provision:bod": "node scripts/provisioning/provision-bod-members.mjs",
    "db:setup": "node scripts/database/supabase-cli.mjs setup",
    "db:push": "node scripts/database/supabase-cli.mjs push",
    "db:verify": "node scripts/database/supabase-cli.mjs verify",
    "db:seed": "npm run provision:bod --",
    "functions:deploy": "node scripts/database/supabase-cli.mjs functions"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/tiro-devanagari-marathi": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "description": "Website for the Rotaract Club of Pune City Legends"
}
